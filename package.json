{
  "name": "dsh-gitbash-win",
  "version": "0.1.0",
  "description": "Choose Git for Windows bash as the agent shell in DeepSeek Harness on Windows. Additive: the official PowerShell executor and tools stay untouched.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git-bash",
    "windows",
    "shell"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1 <0.3.0",
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
