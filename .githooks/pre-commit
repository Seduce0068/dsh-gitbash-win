#!/usr/bin/env bash
# Pre-commit secret scan for this repository (betterleaks).
#
# Enable it once per clone:
#   git config core.hooksPath .githooks
#
# The hook is intentionally non-fatal when betterleaks is not installed: the
# GitHub Actions workflow `.github/workflows/gitleaks.yml` scans every push and
# pull request regardless, so a machine without the scanner still cannot merge
# a leak silently.
set -euo pipefail

if ! command -v betterleaks >/dev/null 2>&1; then
  echo "pre-commit: betterleaks not installed; skipping the secret scan (CI still scans on push)." >&2
  echo "pre-commit: install from https://github.com/betterleaks/betterleaks to scan locally." >&2
  exit 0
fi

# Primary gate: full git-history scan with Betterleaks.
betterleaks git --no-banner --redact .

# Auxiliary scan with Gitleaks when available.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --no-banner --redact .
fi
